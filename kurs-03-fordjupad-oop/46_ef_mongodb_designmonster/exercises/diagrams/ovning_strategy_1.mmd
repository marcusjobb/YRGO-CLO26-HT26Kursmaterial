classDiagram
    class IAttackStrategy {
        <<interface>>
        +Attack(string attackerName) string
    }
    class SwordAttack {
        +Attack(string attackerName) string
    }
    class BowAttack {
        +Attack(string attackerName) string
    }
    class Hero {
        +string Name
        +IAttackStrategy Weapon
        +Attack() string
    }
    IAttackStrategy <|.. SwordAttack
    IAttackStrategy <|.. BowAttack
    Hero "1" -- "1" IAttackStrategy : Weapon
