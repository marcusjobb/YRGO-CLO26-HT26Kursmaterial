classDiagram
    class Monster {
        <<abstract>>
        +string Name
        +int Health
        +Roar() string
    }
    class Goblin {
        +Roar() string
    }
    class Troll {
        +Roar() string
    }
    class MonsterFactory {
        <<static>>
        +Create(string type) Monster
    }
    Monster <|-- Goblin
    Monster <|-- Troll
    MonsterFactory -- Monster : skapar
