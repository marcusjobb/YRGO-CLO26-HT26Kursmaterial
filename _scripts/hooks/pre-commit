#!/bin/bash
# ============================================================
# STUDERANDE-REPO — DIREKTA COMMITS ÄR FÖRBJUDNA
# ============================================================
# Det enda godkända sättet att publicera hit är via:
#   bash CLO26/_scripts/publish_week.sh <kurs> <modul>
# ============================================================

if [ "$PUBLISH_WEEK_AUTHORIZED" != "1" ]; then
  echo "" >&2
  echo "╔══════════════════════════════════════════════════════╗" >&2
  echo "║  COMMIT BLOCKERAD — STUDERANDE-REPO                 ║" >&2
  echo "║                                                      ║" >&2
  echo "║  Direkta commits till studerande-repot är förbjudna.║" >&2
  echo "║                                                      ║" >&2
  echo "║  Publicera via:                                      ║" >&2
  echo "║    bash CLO26/_scripts/publish_week.sh <kurs> <modul>║" >&2
  echo "║                                                      ║" >&2
  echo "║  Kör aldrig git commit här direkt.                  ║" >&2
  echo "╚══════════════════════════════════════════════════════╝" >&2
  echo "" >&2
  exit 1
fi

# Dubbelkolla att _teacher inte smugit sig in
FORBIDDEN=$(git diff --cached --name-only | grep -E "_teacher|solutions/|/exam/|/facit/" || true)
if [ -n "$FORBIDDEN" ]; then
  echo "" >&2
  echo "COMMIT BLOCKERAD: Lärarmaterial hittades i staged filer:" >&2
  echo "$FORBIDDEN" >&2
  exit 1
fi

exit 0
